# 中心服务与主图一条龙服务协同版共用此 PostgreSQL 数据库。
# 生产部署时请填真实连接串，不要把密码提交到仓库。
PRACTICAL_APP_ENV=production
PRACTICAL_HOST=0.0.0.0
PRACTICAL_PORT=18180
PRACTICAL_DATABASE_URL=postgresql+psycopg://main_image:CHANGE_ME@127.0.0.1:5432/main_image_collab
PRACTICAL_DATA_ROOT=/srv/practical-tools
PRACTICAL_COOKIE_SECURE=true
PRACTICAL_SESSION_DAYS=7
PRACTICAL_AUTO_CREATE_TABLES=false
PRACTICAL_MAX_UPLOAD_BYTES=1073741824

# local：中心机本地 storage；tencent_cos：截图使用腾讯云 COS 直传。
PRACTICAL_STORAGE_BACKEND=local
PRACTICAL_COS_BUCKET=
PRACTICAL_COS_REGION=ap-shanghai
PRACTICAL_COS_PREFIX=practical-tools
PRACTICAL_COS_SECRET_ID=
PRACTICAL_COS_SECRET_KEY=

# 在线更新默认关闭；启用后仅允许 HTTPS 更新清单，仍要求 SHA-256 + 文件清单校验。
PRACTICAL_UPDATE_MANIFEST_URL=
PRACTICAL_ALLOW_REMOTE_UPDATE=false

# Agent 仅在协议不兼容时自更新；清单必须是 HTTPS JSON，可使用 {platform} 占位符。
PRACTICAL_AGENT_MIN_PROTOCOL_VERSION=1
PRACTICAL_AGENT_UPDATE_MANIFEST_URL=

# 独立 Windows 中心控制台使用；也可直接在控制台窗口里选择 cloudflared.exe。
# PRACTICAL_CLOUDFLARED_PATH=
# PRACTICAL_TUNNEL_MODE=quick
# PRACTICAL_TUNNEL_NAME=

# 历史迁移脚本默认 dry-run，只有显式传 --apply 才写入。
# 不要配置或上传旧程序 screenshot/browser_state/state.json。
