# 中心服务运行配置（不要把真实密码、COS SecretId/SecretKey 提交到仓库）
PRACTICAL_APP_ENV=production
PRACTICAL_HOST=0.0.0.0
PRACTICAL_PORT=18180
PRACTICAL_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/practical_tools
PRACTICAL_DATA_ROOT=.\data
PRACTICAL_COOKIE_SECURE=false
PRACTICAL_SESSION_DAYS=7
PRACTICAL_AUTO_CREATE_TABLES=false
# 如需腾讯云 COS，由中心服务配置 COS 参数；Agent 只接收预签名 URL。
# PRACTICAL_STORAGE_BACKEND=tencent_cos
PRACTICAL_UPDATE_MANIFEST_URL=
PRACTICAL_ALLOW_REMOTE_UPDATE=false
# Agent 协议版本不兼容时使用。清单应为 HTTPS JSON，可用 {platform} 占位符。
# 清单需包含 version、protocol_version、platform、url、sha256、size。
PRACTICAL_AGENT_MIN_PROTOCOL_VERSION=1
PRACTICAL_AGENT_UPDATE_MANIFEST_URL=
# 独立中心控制台可直接在窗口中选择 cloudflared.exe；也可在这里预设路径和模式。
# PRACTICAL_CLOUDFLARED_PATH=C:\\Program Files\\cloudflared\\cloudflared.exe
# PRACTICAL_TUNNEL_MODE=quick
# PRACTICAL_TUNNEL_NAME=
